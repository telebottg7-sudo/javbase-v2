# ==============================================================================
# Avdb - GitHub JSON Database & Video Metadata Scraper Environment Variables
# ==============================================================================

# Required: GitHub Personal Access Token (PAT) with repository read and write ('repo') permissions.
GITHUB_TOKEN=

# Required: GitHub Target Repository Configuration
# The GitHub repository where all JSON indexes and sharded entity records are persisted.
GITHUB_OWNER=telebottg7-sudo
GITHUB_REPO=Avdb
GITHUB_BRANCH=main

# Root directory inside the GitHub repository for all database files.
# Structure: database/index/, database/pstar/, database/studio/
DATABASE_ROOT=database

# Application Server Port (container ingress binds to 3000)
PORT=3000

# ==============================================================================
# Performance, Caching & Resilience Configuration (Step 10 Tuning)
# ==============================================================================

# Outbound GitHub API request timeout in milliseconds (Default: 15000)
REQUEST_TIMEOUT_MS=15000

# Maximum retry attempts for transient GitHub errors (HTTP 429, 500, 502, 503, 504)
MAX_RETRIES=3

# Exponential backoff base delay in milliseconds (Default: 400)
RETRY_BASE_DELAY_MS=400

# In-memory index and shard cache TTL in milliseconds (Default: 300000 -> 5 minutes)
CACHE_TTL_MS=300000
